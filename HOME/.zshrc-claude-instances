# Use this to launch claude in an iterm tab and change its title.  Otherwise they are alwyas just 'claude'.

claude-tfa() {
      echo -ne "\033]0;TFA - Claude Code\007"
      printf '\e]1337;SetUserVar=titleLock=1\a'
      claude "$@"
      echo -ne "\033]0;\007"
  }

## Other claude commands
export ENABLE_LSP_TOOLS=1  # See https://code.claude.com/docs/en/discover-plugins#code-intelligence

