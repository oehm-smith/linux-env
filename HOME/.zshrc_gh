# 2025-09-10

GH_USER="oehm-smith"
# get_pr_comments
#
# Fetches comments from a GitHub pull request using the gh CLI and jq.
# This function requires the 'gh' and 'jq' commands to be installed and the
# 'GH_USER' and 'GITHUB_TOKEN' environment variables to be set.
#
# Arguments:
#   $1: The pull request number (optional). If not provided, the user will be prompted.
#
get_pr_comments() {
   if [ -n "$1" ]; then
     pr_number="$1"
   else
     read "pr_number?Enter pull request number: "
   fi
   
   # Use double quotes to allow shell variable expansion
   echo "call: gh api repos/:owner/:repo/pulls/$pr_number/comments | jq ...."

  # Store the API call output in a temporary variable and capture the exit code.
  local gh_output
  gh_output=$(gh api repos/:owner/:repo/pulls/$pr_number/comments 2> /dev/null)
  #echo GH_OUTPUT: $gh_output
  if echo "$gh_output" | jq -e '.message == "Not Found" and .status == "404"' > /dev/null; then
    echo "Error: PR #$pr_number doesn't exist." >&2
    return 1
  fi

  # Pipe the successful output to jq for filtering.
  echo "$gh_output" | tr -d '[:cntrl:]' | \
  jq "[ .[] | select(.user.type == \"User\" and .user.login == \"$GH_USER\") | { diff_hunk, line, start_line, body } ]"
}
