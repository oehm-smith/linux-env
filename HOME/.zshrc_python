# ZShell file to separate python stuff in to

# Python and ChatGPT
# https://github.com/pyenv/pyenv#set-up-your-shell-environment-for-pyenv
# export PYENV_ROOT="$HOME/.pyenv"
export PYENV_ROOT="/opt/homebrew/opt/pyenv"
# Add pyenv's bin directory to PATH if it exists
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"

# Only run pyenv init if the pyenv command is now found in PATH
if (( $+commands[pyenv] )); then
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"
fi

[[ -d $HOME/anaconda3/bin ]] && export PATH="$HOME/anaconda3/bin:$PATH"

# Python
#alias python=python3
#alias pip=pip3

# 2026-04-27 - have my own Python library for core code - managed by Claude
BROOKELIB_HOME=~/dev/Python
