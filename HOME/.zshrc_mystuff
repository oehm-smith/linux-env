# Source this from .zshrc
alias historyDisable="function zshaddhistory() {  return 1 }"
alias historyEnable="unset -f zshaddhistory"

# Shell Env
export HISTCONTROL=ignoredups
# bindkey -v
# bindkey '^R' history-incremental-search-backward
# bindkey ^R history-incremental-search-backward
# bindkey ^S history-incremental-search-forward

# 2024-02-06 - history unique to each shell but merged when closes
setopt noincappendhistory
setopt nosharehistory
setopt appendhistory

set editing-mode vi
set blink-matching-paren on
EDITOR=vi	# encrypt_stdin.sh
#alias terminator="/opt/homebrew/bin/terminator"
alias ppm=pnpm

Xhex2decimal(){
  IN=$(echo $@ | tr '[:lower:]' '[:upper:]')
  #echo "ibase=16; $IN" | bc
	echo Not Calling ibase for hex2decimal
}
Xdecimal2hex(){
  #echo "obase=16; $@"|bc
	echo Not Calling ibase for decimal2hex
}

source ~/.iterm2_shell_integration.zsh

# PATH, JAVA_HOME, PNPM_HOME etc. are set in ~/.zprofile (see .zprofile_mystuff).

source ~/.zshrc_python
source ~/.zshrc_node
source ~/.zshrc_kubernetes
source ~/.zshrc_aliasNcommands
source ~/.zshrc_projects
source ~/.zshrc-claude-instances
source ~/.zshrc_vercel

# 2025-05-26 force zwh to automatically reread bins in $PATH since after `brew install` I don't see it until source shell again or `rehash`
setopt hashall

# 2026-01-15 - tab completion.  This tells zsh: "if you don't know what to complete, fall back to files."
zstyle ':completion:*' completer _complete _ignored _files

# 2026-03-15 - Use ctrl-g in Claude to enter in to VIM to enable multi-lines without <return> sending the damm prompt when part way through!
export EDITOR=vim
