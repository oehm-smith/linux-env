#!/usr/bin/env python3
# ABOUTME: Sets iTerm2 tab title and locks it so the shell can't override it.
# ABOUTME: Requires iTerm2 Python API to be enabled (Settings → General → Magic).

import sys
import iterm2

def usage():
    print("Usage: iterm-set-title <title>")
    print("  Sets the current iTerm2 tab title and locks it.")
    print("  Requires: iTerm2 Python API enabled (Settings → General → Magic)")
    sys.exit(1)

if len(sys.argv) < 2:
    usage()

title = " ".join(sys.argv[1:])

async def main(connection):
    app = await iterm2.async_get_app(connection)
    session = app.current_terminal_window.current_tab.current_session
    update = iterm2.LocalWriteOnlyProfile()
    update.set_name(title)
    update.set_allow_title_setting(False)
    update.set_title_components([iterm2.TitleComponents.SESSION_NAME])
    await session.async_set_profile_properties(update)
    print(f"Tab title set to: {title}")

try:
    iterm2.run_until_complete(main, True)
except Exception as e:
    print(f"Error: {e}")
    print("Is the iTerm2 Python API enabled? (Settings → General → Magic)")
    sys.exit(1)
