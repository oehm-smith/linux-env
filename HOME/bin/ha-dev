#!/bin/bash
# ABOUTME: Home Auto CLI wrapper — auto-switches Node version via nvm before running
# ABOUTME: Installed by scripts/install.sh, HA_HOME and HA_ENV placeholders replaced at install time
export HA_HOME="/Users/brooke/dev/home/automation/2026-04-20_manage_home_tools-home_auto-ha"
export HA_ENV="dev"

# Auto-switch to the Node version pinned in .nvmrc if nvm is available
if [ -f "$HA_HOME/.nvmrc" ]; then
  REQUIRED_MAJOR=$(cat "$HA_HOME/.nvmrc" | tr -d 'v' | cut -d. -f1)
  CURRENT_MAJOR=$(node -v 2>/dev/null | tr -d 'v' | cut -d. -f1)

  if [ "$REQUIRED_MAJOR" != "$CURRENT_MAJOR" ]; then
    # Try to load nvm and switch
    if [ -s "$NVM_DIR/nvm.sh" ]; then
      . "$NVM_DIR/nvm.sh" --no-use
      nvm use "$REQUIRED_MAJOR" --silent 2>/dev/null
    elif [ -s "$HOME/.nvm/nvm.sh" ]; then
      . "$HOME/.nvm/nvm.sh" --no-use
      nvm use "$REQUIRED_MAJOR" --silent 2>/dev/null
    fi

    # Verify switch worked
    CURRENT_MAJOR=$(node -v 2>/dev/null | tr -d 'v' | cut -d. -f1)
    if [ "$REQUIRED_MAJOR" != "$CURRENT_MAJOR" ]; then
      echo "Error: ha requires Node.js v${REQUIRED_MAJOR}.x but found $(node -v)."
      echo "Install it with: nvm install $REQUIRED_MAJOR"
      exit 1
    fi
  fi
fi

node "$HA_HOME/packages/cli/dist/index.js" "$@"
