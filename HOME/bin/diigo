#!/bin/bash
# ABOUTME: CLI wrapper for Diigo Tagger AI — delegates to poetry run diigo
# ABOUTME: Installed by scripts/install.sh, /Users/brooke/dev/AI_LLM_GPT/2025-09-01_DiigoTagger replaced at install time
