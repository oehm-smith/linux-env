#!/usr/bin/env python3
# ABOUTME: Scaffolding script that generates a project-local backup.py in the current directory
# ABOUTME: Prompts for config, scans for excludable dirs, writes a ready-to-run backup script

"""
Generate a project-local backup.py script.

Run this from the directory you want to back up. It prompts for
configuration values, scans for directories that should be excluded,
and writes a customised backup.py into the current directory.
"""

import sys
from pathlib import Path

from brookelib.backup import DEFAULT_EXCLUDES

# Directories that get a special mention during scanning — the user is asked
# whether to exclude them rather than auto-excluding.
ASK_DIRS = {"tmp", ".tmp"}


def prompt(label: str, default: str | None = None, required: bool = False) -> str:
    """Prompt the user for a value, with an optional default.

    Args:
        label: The prompt text shown to the user.
        default: Default value accepted on empty input.
        required: If True and no default, keep asking until a value is given.

    Returns:
        The user's input or the default.
    """
    suffix = f" [{default}]" if default else ""
    while True:
        value = input(f"{label}{suffix}: ").strip()
        if not value and default is not None:
            return default
        if value:
            return value
        if required:
            print("  A value is required.")


def prompt_yes_no(label: str, default: bool = True) -> bool:
    """Prompt for a yes/no answer.

    Args:
        label: The prompt text.
        default: Default when the user hits enter.

    Returns:
        True for yes, False for no.
    """
    hint = "Y/n" if default else "y/N"
    value = input(f"{label} [{hint}]: ").strip().lower()
    if not value:
        return default
    return value.startswith("y")


def scan_excludable_dirs(source: Path) -> tuple[list[str], list[str]]:
    """Scan the source directory for known excludable directories.

    Args:
        source: The directory to scan.

    Returns:
        A tuple of (auto_excluded, ask_excluded) directory names found.
    """
    auto_found = []
    ask_found = []
    for entry in sorted(source.iterdir()):
        if not entry.is_dir():
            continue
        name = entry.name
        if name in ASK_DIRS:
            ask_found.append(name)
        elif name in DEFAULT_EXCLUDES:
            auto_found.append(name)
    return auto_found, ask_found


def validate_dest(dest: str, mount_point: str) -> str:
    """Validate the destination path is not the bare mount point.

    Args:
        dest: The destination path entered by the user.
        mount_point: The NAS mount point base path.

    Returns:
        The validated destination path.

    Raises:
        SystemExit: If the path is the bare mount point.
    """
    normalised = dest.rstrip("/")
    mount_normalised = mount_point.rstrip("/")
    if normalised == mount_normalised:
        print(f"\n  Error: destination cannot be the bare mount point ({mount_point}).")
        print("  Please specify a subdirectory, e.g. /Volumes/backup/my-project")
        sys.exit(1)
    return dest


def generate_script(
    source: str,
    dest: str,
    name: str,
    server: str,
    share: str,
    user: str,
    mount_point: str,
    excludes: list[str],
) -> str:
    """Generate the backup.py script content.

    Args:
        source: Absolute path to the source directory.
        dest: Destination path on the NAS.
        name: Human-readable backup name.
        server: NAS server hostname.
        share: SMB share name.
        user: SMB username.
        mount_point: Local mount point path.
        excludes: List of exclude patterns.

    Returns:
        The complete script content as a string.
    """
    excludes_str = "\n".join(f'    "{e}",' for e in excludes)

    lines = [
        '#!/usr/bin/env python3',
        f'"""Backup script for {name}. Generated by backup-install."""',
        '',
        'import argparse',
        '',
        'from brookelib.backup import run_backup',
        'from brookelib.nas import is_mounted, mount, unmount',
        '',
        '# --- Configuration (edit these) ---',
        f'SOURCE = "{source}"',
        f'DEST = "{dest}"',
        f'NAS_SERVER = "{server}"',
        f'NAS_SHARE = "{share}"',
        f'NAS_USER = "{user}"',
        f'MOUNT_POINT = "{mount_point}"',
        '',
        '# Directories/patterns to exclude.',
        '# Do NOT edit this list to add dirs back — use INCLUDES below instead.',
        'EXCLUDES = [',
        excludes_str,
        ']',
        '',
        '# Directories to include even though they appear in EXCLUDES above.',
        '# Move items here from EXCLUDES to back them up.',
        'INCLUDES = [',
        '    # e.g. "node_modules",',
        ']',
        '',
        '',
        'def main():',
        '    """Run the backup."""',
        f'    parser = argparse.ArgumentParser(description="Backup {name}")',
        '    parser.add_argument(',
        '        "--dry-run", action="store_true",',
        '        help="Show what would be synced without doing it",',
        '    )',
        '    parser.add_argument(',
        '        "--no-unmount", action="store_true",',
        '        help="Leave NAS mounted after backup",',
        '    )',
        '    args = parser.parse_args()',
        '',
        '    needs_mount = not is_mounted(MOUNT_POINT)',
        '    if needs_mount:',
        '        print(f"Mounting {NAS_SERVER}/{NAS_SHARE} at {MOUNT_POINT}...")',
        '        mount(MOUNT_POINT, NAS_SERVER, NAS_SHARE, NAS_USER)',
        '',
        '    try:',
        '        run_backup(',
        '            SOURCE, DEST,',
        '            excludes=EXCLUDES,',
        '            includes=INCLUDES,',
        '            dry_run=args.dry_run,',
        '        )',
        '    finally:',
        '        if needs_mount and not args.no_unmount:',
        '            print(f"Unmounting {MOUNT_POINT}...")',
        '            unmount(MOUNT_POINT)',
        '',
        '',
        'if __name__ == "__main__":',
        '    main()',
        '',
    ]
    return "\n".join(lines)


def main():
    """Run the backup-install scaffolding wizard."""
    source = Path.cwd()
    default_name = source.name

    print("=" * 60)
    print("backup-install — generate a backup.py for this directory")
    print("=" * 60)
    print(f"\nSource directory: {source}\n")

    # Check if backup.py already exists
    target = source / "backup.py"
    if target.exists():
        if not prompt_yes_no("backup.py already exists. Overwrite?", default=False):
            print("Aborted.")
            sys.exit(0)

    # Gather configuration
    name = prompt("Backup name", default=default_name)
    user = prompt("NAS user", default="brooke")
    server = prompt("NAS server", default="home-nas.local")
    share = prompt("NAS share", default="backup")
    mount_point = prompt("Mount point", default="/Volumes/backup")
    dest = prompt("Destination path (must be a subdirectory, not the bare mount point)",
                  required=True)
    dest = validate_dest(dest, mount_point)

    # Scan for excludable directories
    print("\nScanning for excludable directories...")
    auto_found, ask_found = scan_excludable_dirs(source)

    excludes = list(DEFAULT_EXCLUDES)

    if auto_found:
        print(f"\n  Auto-excluding (detected in this directory):")
        for d in auto_found:
            print(f"    - {d}")

    if ask_found:
        print(f"\n  Found directories that might be excludable:")
        for d in ask_found:
            if prompt_yes_no(f"    Exclude '{d}'?", default=True):
                if d not in excludes:
                    excludes.append(d)
            else:
                print(f"    Keeping '{d}' in backup")

    if not auto_found and not ask_found:
        print("  No known excludable directories found.")

    # Generate and write the script
    script = generate_script(
        source=str(source),
        dest=dest,
        name=name,
        server=server,
        share=share,
        user=user,
        mount_point=mount_point,
        excludes=excludes,
    )

    target.write_text(script)
    target.chmod(0o755)

    print(f"\n✓ Written: {target}")
    print(f"  Run:     ./backup.py --dry-run")
    print(f"  Edit EXCLUDES/INCLUDES in the script to fine-tune.\n")


if __name__ == "__main__":
    main()
