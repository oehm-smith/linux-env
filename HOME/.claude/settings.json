{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(glab issue *)",
      "Bash(glab mr *)",
      "Bash(glab label *)",
      "Bash(glab status *)",
      "Bash(glab ci *)",
      "Bash(glab repo view *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh status *)",
      "Bash(gh run *)",
      "Bash(gh repo view *)",
      "Bash(nvm use:*)",
      "Bash(nvm exec pnpm:*)",
      "Bash(nvm exec npx vitest:*)",
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(git checkout:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git check-ignore*)",
      "Bash(git symbolic-ref*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "Bash(git blame*)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * ls-files*)",
      "Bash(git -C * ls-tree*)",
      "Bash(git -C * check-ignore*)",
      "Bash(git -C * symbolic-ref*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * remote*)",
      "Bash(git -C * blame*)",
      "Bash(ls:*)",
      "Bash(remind:*)",
      "Bash(cal:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/git-safety-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking git safety..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/no-heredoc-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking for HEREDOCs..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/mr-closes-hook.py",
            "timeout": 5,
            "statusMessage": "Checking MR/PR Closes reference..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(npm install*)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(npm i *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(npm add *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(pnpm install*)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(pnpm add *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(pnpm i *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(pip install *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(pip3 install *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(uv add *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-install-check.sh",
            "if": "Bash(uv pip install *)",
            "timeout": 10,
            "statusMessage": "Checking package against blocklist..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/aboutme-header-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking ABOUTME header..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/aboutme-header-hook.sh",
            "timeout": 5,
            "statusMessage": "Checking ABOUTME header..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(npm install*)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(npm i *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(npm add *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(pnpm install*)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(pnpm add *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(pnpm i *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(pip install *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(pip3 install *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(uv add *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/post-install-audit.sh",
            "if": "Bash(uv pip install *)",
            "timeout": 30,
            "statusMessage": "Running dependency audit..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-philips.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "productivity@knowledge-work-plugins": true,
    "engineering@knowledge-work-plugins": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "feedbackSurveyState": {
    "lastShownTime": 1754087209311
  },
  "theme": "light",
  "editorMode": "vim",
  "verbose": true,
  "preferredNotifChannel": "terminal_bell"
}
