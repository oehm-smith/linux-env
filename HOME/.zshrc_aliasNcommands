# 2025-06-20
# Search CLI commands by substring and optional exact length
# findcmd du 4 - return ncdu
# findcmd ssh
findcmd() {
  local substr="$1"
  local len="$2"

  if [[ -z "$substr" ]]; then
    echo "Usage: findcmd <substring> [length]"
    return 1
  fi

  if [[ -n "$len" ]]; then
    compgen -c | ggrep -E "^.{$len}$" | ggrep "$substr"
  else
    compgen -c | ggrep "$substr"
  fi
}

