# Thousands - print large numbers out with thousands separators.  From https://claude.ai/chat/473a579b-e81d-409a-9f04-67448131a444
#alias thousands="numfmt --grouping"
#alias thousands="awk '{for(i=1; i<NF; i++) {printf \"%s \", \$i | \"numfmt --grouping\"}; print \$NF}'"
